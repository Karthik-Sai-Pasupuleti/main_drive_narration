# API keys / endpoints for the narration models. Loaded at startup by main.py.
# Only needed for agents whose pipeline config sets provider = "openai".
# A shell export of the same variable overrides the value here.

OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (Azure / vLLM / local gateway)
# OPENAI_BASE_URL=

# Optional: Ollama server (default http://localhost:11434)
# OLLAMA_HOST=
